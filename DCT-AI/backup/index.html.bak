        <div class="ai-avatar-online">
          <span>🤖</span>
          <i class="online-indicator"></i>
        </div>
        <div>
          <h4 style="margin:0; font-size:13px; font-weight:700; color:var(--text-main);">Trợ Lý AI Hưng Phát</h4>
          <span style="font-size:10px; color:#10b981; font-weight:600;">● Sẵn sàng phản biện & thẩm định</span>
        </div>
      </div>
      <div class="ai-chat-header-actions">
        <button class="ai-chat-btn-icon" onclick="clearAiChat()" title="Làm mới cuộc trò chuyện">↺</button>
        <button class="ai-chat-btn-icon" onclick="toggleAiChat()" title="Đóng chat">✕</button>
      </div>
    </div>

    <div class="ai-chat-quick-suggestions">
      <div style="font-size:10px; font-weight:700; color:var(--text-muted); margin-bottom:6px;">GỢI Ý CÂU HỎI TRỌNG TÂM:</div>
      <div class="ai-prompt-chips">
        <button class="ai-prompt-chip" type="button" onclick="sendAiChatQuickPrompt('Tại sao loại trừ Cần Thơ?')">❓ Tại sao loại Cần Thơ?</button>
        <button class="ai-prompt-chip" type="button" onclick="sendAiChatQuickPrompt('Ưu thế vượt trội của Đà Nẵng?')">❓ Ưu thế Đà Nẵng?</button>
        <button class="ai-prompt-chip" type="button" onclick="sendAiChatQuickPrompt('Dữ liệu đã làm sạch những gì?')">❓ Dữ liệu đã làm sạch?</button>
        <button class="ai-prompt-chip" type="button" onclick="sendAiChatQuickPrompt('Kịch bản phản biện Ban Giám Đốc nếu bị yêu cầu chọn Hải Phòng?')">❓ Phản biện Hải Phòng?</button>
        <button class="ai-prompt-chip" type="button" onclick="sendAiChatQuickPrompt('Nếu tuyển thêm 3 kỹ sư triển khai thì sao?')">❓ Thêm 3 kỹ sư?</button>
        <button class="ai-prompt-chip" type="button" onclick="sendAiChatQuickPrompt('Luận điểm trình Ban Giám Đốc?')">❓ Luận điểm trình BGĐ?</button>
      </div>
    </div>

    <div class="ai-chat-body" id="ai-chat-messages">
      <div class="ai-msg bot">
        <div class="ai-msg-avatar">🤖</div>
        <div class="ai-msg-bubble">
          <strong>Trợ lý AI Hưng Phát:</strong> Xin chào Trưởng phòng! Tôi là AI Agent đồng hành phân tích và đối soát thị trường mở rộng WMS.
          <br><br>Tôi đã sẵn sàng giải đáp thắc mắc về độ khớp giải pháp WMS, khả năng hỗ trợ on-site của đội 5 kỹ sư, hoặc kịch bản phản biện Ban Giám Đốc.
        </div>
      </div>
    </div>

    <div class="ai-chat-footer">
      <form id="ai-chat-form" onsubmit="handleAiChatSubmit(event)" style="display:flex; gap:8px; width:100%; align-items:center;">
        <input type="text" id="ai-chat-input" placeholder="Hỏi AI về địa bàn, dữ liệu, phản biện..." autocomplete="off">
        <button type="submit" id="ai-chat-send-btn" title="Gửi tin nhắn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </form>
    </div>
  </div>

