        </form>
      </div>
    </div>
  </div>

  <!-- Modal Chi Tiết Tương Tác Giữa Các Task & Địa Bàn -->
  <div class="modal-backdrop" id="app-modal">
    <div class="modal-box">
      <div class="modal-head">
        <h3 id="modal-title">Chi tiết nhiệm vụ</h3>
        <button class="modal-close" onclick="closeModal()">×</button>
      </div>
      <div class="modal-body" id="modal-body"></div>
      <div class="modal-footer">
        <button class="ghost-btn" id="modal-action-btn">Mở màn hình chuyên sâu</button>
        <button class="primary-btn" onclick="closeModal()">Đóng</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
  <script src="app.js"></script>
</body>
</html>
