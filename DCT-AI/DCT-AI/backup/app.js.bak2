// ================= 16. QUẢN LÝ TÀI KHOẢN & ĐĂNG NHẬP / ĐĂNG XUẤT (AUTHENTICATION SYSTEM) =================

const AUTH_PROFILES = {
  admin: {
    id: 'admin',
    name: 'Lê Văn Hưng',
    roleTitle: 'Quản trị viên & Trưởng phòng PTKD',
    roleBadge: 'Administrator',
    avatar: 'AD',
    email: 'hung.le@hungphat.vn',
    dept: 'Phát triển Kinh doanh & Mở rộng',
    permission: 'Toàn quyền Thẩm định & Phê duyệt',
    statusText: '● Trực tuyến (Online)',
    isLoggedIn: true
  },
  analyst: {
    id: 'analyst',
    name: 'Nguyễn Minh Khoa',
    roleTitle: 'Chuyên viên Khảo sát & PTKD',
    roleBadge: 'Chuyên viên',
    avatar: 'MK',
    email: 'khoa.nguyen@hungphat.vn',
    dept: 'Phát triển Kinh doanh',
    permission: 'Khảo sát địa bàn, Nạp dữ liệu & Đề xuất',
    statusText: '● Trực tuyến (Online)',
    isLoggedIn: true
  },
  guest: {
    id: 'guest',
    name: 'Khách vãng lai',
    roleTitle: 'Chưa đăng nhập (Nhấn để đăng nhập)',
    roleBadge: 'Khách',
    avatar: 'KH',
    email: 'Chưa xác thực',
    dept: 'Khách xem báo cáo',
    permission: 'Chỉ xem báo cáo mẫu',
    statusText: '○ Chưa đăng nhập',
    isLoggedIn: false
  }
};

let currentAuthUser = AUTH_PROFILES.admin;

function initAuthSystem() {
  try {
    const saved = localStorage.getItem('hungphat_current_user');
    if (saved) {
      const parsed = JSON.parse(saved);
      if (parsed && parsed.id && AUTH_PROFILES[parsed.id]) {
        currentAuthUser = AUTH_PROFILES[parsed.id];
      }
    }
  } catch (e) {
    console.warn('Cannot load user from localStorage:', e);
  }

  updateAuthUI();

  const topbarBtn = document.getElementById('topbar-user-btn');
  if (topbarBtn) {
    topbarBtn.onclick = openAuthModal;
  }

  const sidebarMini = document.getElementById('sidebar-user-mini');
  if (sidebarMini) {
    sidebarMini.onclick = openAuthModal;
  }
}

function updateAuthUI() {
  const isLogged = currentAuthUser && currentAuthUser.isLoggedIn;

  // Topbar UI
  const topbarAvatar = document.getElementById('topbar-avatar');
  const topbarName = document.getElementById('topbar-user-name');
  const topbarRole = document.getElementById('topbar-user-role');
  const topbarDot = document.getElementById('topbar-status-dot');

  if (topbarAvatar) topbarAvatar.textContent = currentAuthUser.avatar;
  if (topbarName) topbarName.textContent = currentAuthUser.name;
  if (topbarRole) topbarRole.textContent = isLogged ? currentAuthUser.roleBadge : 'Đăng nhập';
  if (topbarDot) {
    if (isLogged) topbarDot.classList.remove('logged-out');
    else topbarDot.classList.add('logged-out');
  }

  // Sidebar UI
  const sidebarAvatar = document.getElementById('sidebar-avatar');
  const sidebarName = document.getElementById('sidebar-user-name');
  const sidebarRole = document.getElementById('sidebar-user-role');

  if (sidebarAvatar) sidebarAvatar.textContent = currentAuthUser.avatar;
  if (sidebarName) sidebarName.textContent = currentAuthUser.name;
  if (sidebarRole) sidebarRole.textContent = currentAuthUser.roleTitle;

  // Modal Details
  const cardAvatar = document.getElementById('auth-card-avatar');
  const cardName = document.getElementById('auth-card-name');
  const cardRole = document.getElementById('auth-card-role');
  const cardEmail = document.getElementById('auth-card-email');

  if (cardAvatar) cardAvatar.textContent = currentAuthUser.avatar;
  if (cardName) cardName.textContent = currentAuthUser.name;
  if (cardRole) cardRole.textContent = currentAuthUser.roleTitle;
  if (cardEmail) cardEmail.textContent = '📧 ' + currentAuthUser.email;

  // Toggle views in modal
  const loggedInView = document.getElementById('auth-logged-in-view');
  const loggedOutView = document.getElementById('auth-logged-out-view');
  const modalBadge = document.getElementById('auth-modal-badge');
  const modalHeading = document.getElementById('auth-modal-heading');

  if (isLogged) {
    if (loggedInView) loggedInView.style.display = 'block';
    if (loggedOutView) loggedOutView.style.display = 'none';
    if (modalBadge) modalBadge.textContent = '👤 TÀI KHOẢN HỆ THỐNG';
    if (modalHeading) modalHeading.textContent = 'Thông tin Tài khoản';
  } else {
    if (loggedInView) loggedInView.style.display = 'none';
    if (loggedOutView) loggedOutView.style.display = 'block';
    if (modalBadge) modalBadge.textContent = '🔐 XÁC THỰC DANH TÍNH';
    if (modalHeading) modalHeading.textContent = 'Đăng nhập Hệ thống DCT AI';
  }
}

function openAuthModal() {
  const modal = document.getElementById('auth-modal');
  if (modal) {
    modal.style.display = 'grid';
    updateAuthUI();
  }
}

function closeAuthModal() {
  const modal = document.getElementById('auth-modal');
  if (modal) modal.style.display = 'none';
}

function showLoginForm() {
  const loggedInView = document.getElementById('auth-logged-in-view');
  const loggedOutView = document.getElementById('auth-logged-out-view');
  const modalBadge = document.getElementById('auth-modal-badge');
  const modalHeading = document.getElementById('auth-modal-heading');

  if (loggedInView) loggedInView.style.display = 'none';
  if (loggedOutView) loggedOutView.style.display = 'block';
  if (modalBadge) modalBadge.textContent = '🔄 CHUYỂN ĐỔI TÀI KHOẢN';
  if (modalHeading) modalHeading.textContent = 'Đăng nhập tài khoản khác';
}

function handleLogout() {
  currentAuthUser = AUTH_PROFILES.guest;
  try {
    localStorage.setItem('hungphat_current_user', JSON.stringify(currentAuthUser));
  } catch (e) {}

  updateAuthUI();
  closeAuthModal();
  notify('Đã đăng xuất tài khoản. Hệ thống chuyển sang chế độ Khách xem dữ liệu.');
}

function handleLoginSubmit(e) {
  if (e && e.preventDefault) e.preventDefault();
  const uInput = document.getElementById('login-username');
  const val = (uInput ? uInput.value.trim().toLowerCase() : '') || 'admin';

  if (val.includes('analyst') || val.includes('khoa') || val.includes('chuyen vien')) {
    currentAuthUser = AUTH_PROFILES.analyst;
  } else {
    currentAuthUser = AUTH_PROFILES.admin;
  }

  try {
    localStorage.setItem('hungphat_current_user', JSON.stringify(currentAuthUser));
  } catch (e) {}

  updateAuthUI();
  closeAuthModal();
  notify(`Đăng nhập thành công! Chào mừng ${currentAuthUser.name} (${currentAuthUser.roleBadge}).`);
}

function fillQuickAccount(type) {
  const uInput = document.getElementById('login-username');
  const pInput = document.getElementById('login-password');
  if (type === 'analyst') {
    if (uInput) uInput.value = 'khoa.nguyen@hungphat.vn';
    if (pInput) pInput.value = 'analyst2026';
  } else {
    if (uInput) uInput.value = 'admin';
    if (pInput) pInput.value = 'hungphat2026';
  }
}

// Khởi chạy các tính năng tương tác mới
initSidebarHoverBehavior();
initAuthSystem();
