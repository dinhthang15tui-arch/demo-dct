function exportPptDeliverable() {
  if (!hasAnalyzed) {
    notify('Vui lòng hoàn tất xử lý tệp trước khi xuất file PowerPoint!');
    return;
  }

  const pptHtml = `
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title>Slide Trình Chiếu Ban Giám Đốc - Hưng Phát WMS</title>
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; background: #0f172a; color: #fff; margin: 0; padding: 20px; }
    .slide { background: linear-gradient(135deg, #0b1730 0%, #15325c 100%); border-radius: 14px; padding: 40px; margin-bottom: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); border: 1px solid #1e3a66; min-height: 400px; position: relative; }
    .slide-no { position: absolute; right: 25px; top: 25px; background: rgba(255,255,255,0.1); padding: 4px 10px; border-radius: 20px; font-size: 11px; }
    h1 { font-size: 28px; color: #38bdf8; margin: 0 0 10px; }
    h2 { font-size: 22px; color: #60a5fa; margin: 0 0 20px; border-bottom: 2px solid #2563eb; padding-bottom: 10px; }
    p, li { font-size: 15px; line-height: 1.7; color: #cbd5e1; }
    .highlight-card { background: rgba(255,255,255,0.06); padding: 15px; border-radius: 10px; border-left: 4px solid #38bdf8; margin: 15px 0; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .badge { display: inline-block; background: #10b981; color: #fff; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 12px; }
    @media print { .slide { page-break-after: always; height: 100vh; margin: 0; border: none; } }
  </style>
</head>
<body>
  <div class="slide">
    <span class="slide-no">Slide 1 / 5</span>
    <h1>CÔNG TY CỔ PHẦN GIẢI PHÁP QUẢN LÝ KHO HƯNG PHÁT</h1>
    <h2 style="border:none; color:#94a3b8; font-size:16px;">Báo Cáo Nghiên Cứu & Đề Xuất Chiến Lược</h2>
    <div style="margin-top:60px;">
      <h2 style="font-size:32px; color:#fff;">LỰA CHỌN 02 ĐỊA BÀN KHẢO SÁT MỞ RỘNG THỊ TRƯỜNG</h2>
      <p style="font-size:18px; color:#38bdf8;">Báo cáo Trình Ban Giám Đốc Phê Duyệt</p>
      <p style="color:#94a3b8; margin-top:40px;">Người trình bày: Trưởng phòng Phát triển Kinh doanh - Lê Văn Hưng<br>Thời gian: Tháng 11/2026</p>
    </div>
  </div>

  <div class="slide">
    <span class="slide-no">Slide 2 / 5</span>
    <h2>1. BỐI CẢNH & GIỚI HẠN NGUỒN LỰC</h2>
    <div class="grid">
      <div class="highlight-card">
        <h3 style="color:#38bdf8; margin:0 0 8px;">Mục Tiêu Mở Rộng</h3>
        <p>• Nghiên cứu 04 địa bàn tiềm năng.<br>• Mục tiêu: Chọn ra <strong>02 địa bàn tối ưu nhất</strong> để khảo sát thực địa khách hàng.</p>
      </div>
