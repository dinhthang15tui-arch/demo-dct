// Khởi tạo views & navigation
const navItems = document.querySelectorAll('.nav-item');
const views = document.querySelectorAll('.view');
const pageTitle = document.getElementById('page-title');
const toast = document.getElementById('toast');

const titles = {
  overview: 'Giới thiệu hệ thống',
  input: 'Xử lý & Khởi chạy',
  analysis: 'Phân tích thị trường',
  compare: 'So sánh kết quả',
  reports: 'Báo cáo kết quả',
  logs: 'Nhật ký Agent'
};

function switchView(viewName) {
  navItems.forEach(x => {
    if (x.dataset.view === viewName) {
      x.classList.add('active');
    } else {
      x.classList.remove('active');
    }
  });

  views.forEach(v => {
    v.classList.toggle('active', v.id === viewName);
  });

  if (pageTitle) pageTitle.textContent = titles[viewName] || 'Hệ thống';
  window.scrollTo({ top: 0, behavior: 'smooth' });

  // Đóng dock menu nếu đang mở
  const dock = document.getElementById('floating-dock');
  if (dock) dock.classList.remove('open');

  // Cập nhật trạng thái hiển thị của màn hình Báo cáo kết quả
  if (viewName === 'reports') {
    updateReportsViewState();
  }
}

function updateReportsViewState() {
  const emptyState = document.getElementById('reports-empty-state');
  const resultsContainer = document.getElementById('reports-results-container');
  if (!emptyState || !resultsContainer) return;

  if (hasData || hasAnalyzed) {
    emptyState.style.display = 'none';
    resultsContainer.style.display = 'block';
    setTimeout(renderAnalyticsCharts, 120);
  } else {
    emptyState.style.display = 'block';
    resultsContainer.style.display = 'none';
  }
}

navItems.forEach(btn => {
  btn.addEventListener('click', () => {
    switchView(btn.dataset.view);
  });
});

function notify(msg) {
  if (!toast) return;
  toast.textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 2800);
}

// ================= 1. KÉO THẢ TỆP VÀO TRUNG TÂM XỬ LÝ =================

const dropZone = document.getElementById('drop-zone');
const fileInput = document.getElementById('file-input');

if (dropZone) {
  ['dragenter', 'dragover'].forEach(eventName => {
    dropZone.addEventListener(eventName, e => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.add('drag-over');
    }, false);
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropZone.addEventListener(eventName, e => {
      e.preventDefault();
      e.stopPropagation();
      dropZone.classList.remove('drag-over');
    }, false);
  });

  dropZone.addEventListener('drop', e => {
    const dt = e.dataTransfer;
    const files = dt.files;
    handleUploadedFiles(files);
  }, false);
}

if (fileInput) {
  fileInput.addEventListener('change', () => {
    handleUploadedFiles(fileInput.files);
  });
}

function handleUploadedFiles(files) {
  const fileArray = [...files];
  if (fileArray.length === 0) return;

  const fileList = document.getElementById('file-list');
  fileList.innerHTML = fileArray.map(f => {
    let badge = '📄 TỆP KHÁC';
    let badgeClass = 'badge-word';
    const lowerName = f.name.toLowerCase();

    if (lowerName.endsWith('.xlsx') || lowerName.endsWith('.xls') || lowerName.endsWith('.csv')) {
      badge = '📊 EXCEL';
      badgeClass = 'badge-excel';
    } else if (lowerName.endsWith('.docx') || lowerName.endsWith('.doc')) {
      badge = '📄 WORD';
      badgeClass = 'badge-word';
    } else if (lowerName.endsWith('.pptx') || lowerName.endsWith('.ppt')) {
      badge = '📑 POWERPOINT';
      badgeClass = 'badge-ppt';
    }

    return `
      <div style="padding:10px; border-bottom:1px solid #e5edf7; display:flex; justify-content:space-between; align-items:center;">
        <div>
          <span class="file-type-badge ${badgeClass}">${badge}</span>
          <strong style="margin-left:6px; color:var(--text-main);">${f.name}</strong>
          <small style="color:var(--text-muted); margin-left:8px;">(${(f.size / 1024).toFixed(1)} KB)</small>
        </div>
        <span style="font-size:10px; color:#10b981; font-weight:700;">✓ Đã tiếp nhận</span>
      </div>
    `;
  }).join('');

  activateDataState(fileArray.length);
  notify(`Đã nạp thành công ${fileArray.length} tệp! Bấm "Khởi Chạy AI Agent" để xử lý.`);
}

